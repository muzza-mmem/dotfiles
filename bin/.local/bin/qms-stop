#!/usr/bin/env bash
#
# qms-stop — bring down both the QMS and core stacks.
#
# Steps run strictly in order; each must finish before the next begins.
#   1. Stop portal-qms
#   2. Stop portal-core
#
set -euo pipefail

QMS_DIR="$HOME/code/portal-qms"
CORE_DIR="$HOME/code/portal-core"

echo "==> Stopping portal-qms"
cd "$QMS_DIR"
./scripts/stop

echo "==> Stopping portal-core"
cd "$CORE_DIR"
./scripts/stop

echo "==> Both stacks stopped"
