/nvim/.config/nvim/lazy-lock.json
/tmux/.config/tmux/plugins

# herdr's installed-plugin store: `herdr plugin install` clones the plugin repo
# and compiles its binary here (~9MB each). 50-stow.sh keeps
# ~/.config/herdr/plugins a real directory so this never lands in the working
# tree — this is the belt for when it does anyway.
/herdr/.config/herdr/plugins/github/

# --- Claude Code runtime state -------------------------------------------
# If ~/.claude is ever a folded Stow symlink into this repo (see REAL_DIRS in
# _migration/install/50-stow.sh, which prevents that), Claude Code writes its
# live state here: .credentials.json (an OAuth token), history.jsonl, session
# transcripts, caches, logs, installed plugins. None of that may be committed.
#
# Belt: the credential, named explicitly so it is impossible to miss.
/claude/.claude/.credentials.json
#
# Braces: ignore everything under the package and re-admit only the files the
# package genuinely owns. Anything new Claude Code writes is ignored by
# default; a new config file we want tracked needs a `!` line added below.
/claude/.claude/*
!/claude/.claude/CLAUDE.md
!/claude/.claude/settings.json
!/claude/.claude/keybindings.json
!/claude/.claude/statusline-command.sh
!/claude/.claude/hooks/
!/claude/.claude/skills/

# Virtualenvs created by harness-installed skills (never commit these)
/claude/.claude/skills/*/.venv/
